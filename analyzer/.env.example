# 2D DNS Analyzer — configuração
# Produção: /etc/2d-dnsanalyzer/analyzer.env (dono root:dnsanalyzer, modo 640).
# ATENÇÃO: o systemd não aceita comentário na mesma linha do valor.

# ---- PostgreSQL
DATABASE_URL=postgresql://dnsanalyzer:TROQUE_A_SENHA@127.0.0.1:5432/dnsanalyzer

# ---- Technitium (somente leitura dos Query Logs; usuário dedicado com permissão Logs: View)
TECHNITIUM_URL=http://10.100.10.15:5380
TECHNITIUM_TOKEN=
TECHNITIUM_LOGS_APP=Query Logs (Sqlite)
TECHNITIUM_LOGS_CLASS=QueryLogsSqlite.App

# ---- Coleta
# intervalo entre coletas (s)
INGEST_INTERVAL_SECONDS=300
# atraso de segurança: o Technitium grava os logs em lote (s)
INGEST_LAG_SECONDS=120
# na 1ª execução, quanto histórico importar (h)
INGEST_BACKFILL_HOURS=168
INGEST_PAGE_SIZE=5000
# tamanho máximo de cada janela de coleta (min)
INGEST_MAX_WINDOW_MINUTES=60
# IPs/CIDRs ignorados, separados por vírgula (ex.: a própria VM do analisador)
EXCLUDE_CLIENTS=10.100.10.4/32
INTERNAL_SUFFIXES=local,lan,internal,home.arpa,in-addr.arpa,ip6.arpa,resolver.arpa
# malha WireGuard: 10.100.100.N = roteador do site 10.N.0.0/16
MESH_CIDR=10.100.100.0/24

# ---- IA local (Ollama)
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=600
LLM_NUM_CTX=4096
# 0 = nº de CPUs - 2
LLM_NUM_THREAD=0
LLM_KEEP_ALIVE=60m
LLM_MAX_ATTEMPTS=3
# true = não gasta IA com x.github.io / x.cloudfront.net (ficam só nas regras)
LLM_SKIP_HOSTING_SUBDOMAINS=false

# ---- Enriquecimento
# idade do domínio via RDAP público (só o NOME do domínio sai da rede)
RDAP_ENABLED=true
RDAP_CACHE_DAYS=30
# não consulta RDAP de domínios populares (rank Tranco <= este valor)
RDAP_SKIP_TOP_RANK=100000

# ---- Identificação por fontes públicas (Wikidata / certificado TLS / página do site)
WEB_INTEL_ENABLED=true
# abrir a página inicial do site (só quando não há sinal de ameaça)
WEB_FETCH_SITE=true
WEB_CACHE_DAYS=30

# ---- Análise
REANALYZE_DAYS=30
# retenção das consultas agregadas (partições mensais)
RETENTION_DAYS=180
# detectores de comportamento/alertas (e envio do webhook) a cada N segundos
BEHAVIOR_INTERVAL_SECONDS=300

# ---- Aviso à TI (webhook) em alertas de risco
# URLs separadas por vírgula (Teams/Slack/Discord/Google Chat/n8n...). Vazio = desligado.
WEBHOOK_URLS=
WEBHOOK_KINDS=malicious_access,suspicious_access,dga_burst
PORTAL_URL=https://dns-guard.2dtecnologia.com

# ---- Etapa 2: busca na web (SearXNG local) p/ o que a IA deixou como DESCONHECIDO.
# Roda só com a fila da etapa 1 vazia; 1 busca por domínio. Vazio = desligada.
WEB_SEARCH_URL=
WEB_SEARCH_RESULTS=6
# Push no celular pelo MESMO canal do 2D-Monitoramento (API do ERP, /push/send para
# os inscritos no app PUSH_APP_NAME). Vazio = desligado. Token = MONITORAMENTO_API_TOKEN.
PUSH_API_URL=
PUSH_API_TOKEN=
PUSH_APP_NAME=2D-Monitoramento

# ---- API interna (consumida pelo portal)
API_HOST=0.0.0.0
API_PORT=8088
# gere com: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- Logs próprios e dados
LOG_DIR=/var/log/2d-dnsanalyzer
LOG_LEVEL=INFO
DATA_DIR=/var/lib/2d-dnsanalyzer
TLDEXTRACT_CACHE=/var/lib/2d-dnsanalyzer/tldextract
