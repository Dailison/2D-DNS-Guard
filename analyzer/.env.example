# 2D DNS Analyzer — configuração
# Produção: /etc/2d-dnsanalyzer/analyzer.env (dono root:dnsanalyzer, modo 640).
# ATENÇÃO: o systemd não aceita comentário na mesma linha do valor.

# ---- PostgreSQL
DATABASE_URL=postgresql://dnsanalyzer:TROQUE_A_SENHA@127.0.0.1:5432/dnsanalyzer

# ---- Technitium (somente leitura dos Query Logs; usuário dedicado com permissão Logs: View)
TECHNITIUM_URL=http://10.100.10.15:5380
TECHNITIUM_TOKEN=
TECHNITIUM_LOGS_APP=Query Logs (Sqlite)
TECHNITIUM_LOGS_CLASS=QueryLogsSqlite.App

# ---- Coleta
# intervalo entre coletas (s)
INGEST_INTERVAL_SECONDS=60
# atraso de segurança: o Technitium grava os logs em lote (s)
INGEST_LAG_SECONDS=60
# na 1ª execução, quanto histórico importar (h)
INGEST_BACKFILL_HOURS=168
INGEST_PAGE_SIZE=5000
# tamanho máximo de cada janela de coleta (min)
INGEST_MAX_WINDOW_MINUTES=60
# IPs/CIDRs ignorados, separados por vírgula (ex.: a própria VM do analisador)
EXCLUDE_CLIENTS=10.100.10.4/32
INTERNAL_SUFFIXES=local,lan,internal,home.arpa,in-addr.arpa,ip6.arpa,resolver.arpa
# malha WireGuard: 10.100.100.N = roteador do site 10.N.0.0/16
MESH_CIDR=10.100.100.0/24

# ---- IA local (Ollama)
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# modelo do reforço com GPU (OLLAMA_EXTRA_URLS); vazio = o mesmo de OLLAMA_MODEL
OLLAMA_EXTRA_MODEL=
# reforços (PCs com GPU), separados por vírgula; "url=modelo" dá um modelo próprio ao reforço. Vazio = só a VM.
# Ex.: http://10.100.50.201:11434,http://10.100.20.6:11434=gemma4:26b
OLLAMA_EXTRA_URLS=
# análises simultâneas por reforço (padrão LLM_EXTRA_WORKERS); igual ao OLLAMA_NUM_PARALLEL daquele PC
LLM_EXTRA_WORKERS=2
LLM_EXTRA_WORKERS_URL=
# reforços que atendem as fases 2/3 e a pergunta de lista (vazio = todos, em rodízio); deixe a GPU lenta de fora
OLLAMA_ETAPAS_URLS=
# prazo de cada pedido ao reforço (s): a GTX 1060 leva ~35 s sem cache e ~15 s com cache (29/09)
LLM_EXTRA_TIMEOUT_SECONDS=90
LLM_TIMEOUT_SECONDS=600
# a pergunta da fase 1 (etapa única) tem ~5,2 mil tokens: com 4096 o Ollama corta o começo e a resposta sai sem sentido
LLM_NUM_CTX=8192
# 0 = nº de CPUs - 2
LLM_NUM_THREAD=0
LLM_KEEP_ALIVE=60m
LLM_MAX_ATTEMPTS=3
# true = não gasta IA com x.github.io / x.cloudfront.net (ficam só nas regras)
LLM_SKIP_HOSTING_SUBDOMAINS=false
# triagem por acesso: domínio com menos de LLM_MIN_QUERIES consultas E menos de LLM_MIN_CLIENTS computadores
# vai para o fim da fila da IA (analisado quando ela esvazia ou quando recorrer). Risco e análise pedida não esperam. 0 desliga.
LLM_MIN_QUERIES=3
LLM_MIN_CLIENTS=2

# ---- Enriquecimento
# idade do domínio via RDAP público (só o NOME do domínio sai da rede)
RDAP_ENABLED=true
RDAP_CACHE_DAYS=30
# não consulta RDAP de domínios populares (rank Tranco <= este valor)
RDAP_SKIP_TOP_RANK=100000

# ---- Identificação por fontes públicas (Wikidata / certificado TLS / página do site)
WEB_INTEL_ENABLED=true
# abrir a página inicial do site (só quando não há sinal de ameaça)
WEB_FETCH_SITE=true
WEB_CACHE_DAYS=30

# ---- Análise
REANALYZE_DAYS=30
# retenção das consultas agregadas (partições mensais)
RETENTION_DAYS=180
# cópia linha a linha das consultas (query_log, partição por dia): dias guardados
LOG_RETENCAO_DIAS=7
# detectores de comportamento/alertas (e envio do webhook) a cada N segundos
BEHAVIOR_INTERVAL_SECONDS=300

# ---- Aviso à TI (webhook) em alertas de risco
# URLs separadas por vírgula (Teams/Slack/Discord/Google Chat/n8n...). Vazio = desligado.
WEBHOOK_URLS=
WEBHOOK_KINDS=malicious_access,suspicious_access,dga_burst
PORTAL_URL=https://dns-guard.2dtecnologia.com

# ---- Etapa 2: busca na web (SearXNG local) p/ o que a IA deixou como DESCONHECIDO.
# Roda só com a fila da etapa 1 vazia; 1 busca por domínio. Vazio = desligada.
# Vários SearXNG separados por vírgula (ex.: o da VM e o do PC do reforço): cada um sai por um IP
# público e tem a própria cota nos buscadores; o que falhar fica 5 min de lado.
WEB_SEARCH_URL=
WEB_SEARCH_RESULTS=6
# intervalo mínimo entre buscas (s), em cada SearXNG: os buscadores bloqueiam rajadas
WEB_SEARCH_MIN_INTERVAL=20
# fase 1: não busca na web p/ domínio até esta posição do Tranco (a IA o conhece); 0 = busca em todos
WEB_SEARCH_SKIP_RANK=0
# Push no celular pelo MESMO canal do 2D-Monitoramento (API do ERP, /push/send para
# os inscritos no app PUSH_APP_NAME). Vazio = desligado. Token = MONITORAMENTO_API_TOKEN.
PUSH_API_URL=
PUSH_API_TOKEN=
PUSH_APP_NAME=2D-Monitoramento

# ---- API interna (consumida pelo portal)
API_HOST=0.0.0.0
API_PORT=8088
# gere com: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- Logs próprios e dados
LOG_DIR=/var/log/2d-dnsanalyzer
LOG_LEVEL=INFO
DATA_DIR=/var/lib/2d-dnsanalyzer
TLDEXTRACT_CACHE=/var/lib/2d-dnsanalyzer/tldextract

# ---- Fase 6: investigação profunda (29/09). Com a fila da IA vazia, DESCONHECIDOS/SUSPEITOS são investigados a
# fundo (registros DNS, certificados públicos, Wayback, páginas do site, buscas pela marca, coocorrência nos logs do
# Technitium) em duas rodadas de IA, na GPU do reforço se no ar (senão na VM). Com serviço reconhecido e confiança
# >= INVESTIGACAO_CONFIANCA_MIN muda a classificação e a lista; sem certeza só guarda o dossiê (página do domínio).
INVESTIGACAO_ENABLED=false
INVESTIGACAO_DIAS=14
INVESTIGACAO_CONFIANCA_MIN=0.85
# prazo por domínio (s): fontes em paralelo + rodadas da IA enquanto sobra tempo p/ o veredito e o revisor
INVESTIGACAO_TEMPO_MAX=600
# chaves gratuitas p/ a fase 6 (vazias = fonte desligada): URLScan (qual script da página chama o domínio) e
# VirusTotal (categoria do domínio segundo ~10 fornecedores de segurança; 4/min, 500/dia)
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
