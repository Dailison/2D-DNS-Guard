[Unit]
Description=2D DNS Analyzer - classificador contínuo (regras + IA local Ollama/Qwen3)
After=network-online.target postgresql.service ollama.service
Wants=postgresql.service ollama.service

[Service]
Type=simple
User=dnsanalyzer
Group=dnsanalyzer
EnvironmentFile=/etc/2d-dnsanalyzer/analyzer.env
WorkingDirectory=/opt/2d-dnsanalyzer/app
ExecStart=/opt/2d-dnsanalyzer/venv/bin/python -m dnsanalyzer run-classifier
Restart=always
RestartSec=15
Nice=10
TimeoutStopSec=660
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/2d-dnsanalyzer /var/lib/2d-dnsanalyzer

[Install]
WantedBy=multi-user.target
